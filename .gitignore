# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/

# --- venv ---
.venv/
venv/

# --- IDE ---
.vscode/
.idea/
*.swp

# --- Project data ---
# Per-user workbook + capture history + backups. Never goes into git.
data/
logs/
pip_install.log

# --- Excel files (workbook lives in data/, but also exclude stray copies) ---
*.xlsx
*.xls
*.xlsm

# --- PyInstaller intermediate ---
*.spec.bak
# build_app.spec is the canonical PyInstaller spec — keep it tracked.
!build_app.spec

# --- OCR model cache (downloaded at first run) ---
models/cache/

# --- Claude Code memory (machine-specific) ---
.claude/

# --- Secrets (Gemini API key for OCR experiment) ---
.gemini_key
*.gemini_key

# --- Secrets (Google OAuth client for roster sync; token cache lives in data/) ---
.google_oauth_client.json

# --- Release initialization inputs (initialize/) ---
# The two seed workbooks ship into the bundle's data/ at build time — they
# ARE tracked (override the global *.xlsx rule above). The internal
# config.ini carries REAL secrets (sheet_url, Gemini key) and must never
# be committed — the repo is public.
!initialize/guild_scores.xlsx
!initialize/league_scores.xlsx
initialize/config.ini

# --- OS ---
Thumbs.db
.DS_Store
